// Cloud schema (Supabase PostgreSQL).
//
// Design note: the desktop SQLite schema evolves quickly and is the source of
// truth for each business. The cloud therefore stores *business entities* as
// versioned JSON documents (SyncRecord) plus an append-only change log
// (SyncChange). This gives lossless two-way sync, 3-way merging (the log keeps
// every historical version) and lets web/mobile clients be added later without
// schema migrations for every desktop change. Identity, security, billing and
// audit data are strongly typed relational tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETE
  FAILED
  CANCELED
}

enum TrialScanStatus {
  AVAILABLE
  IN_PROGRESS
  USED
}

// ───────────── Identity ─────────────

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  devices       Device[]
  records       SyncRecord[]
  changes       SyncChange[]
  restoreGrants RestoreGrant[]
  trial        BusinessTrial?
  auditLogs     AuditLog[]
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  businessId       String    @db.Uuid
  email            String    @unique
  passwordHash     String
  fullName         String
  role             Role      @default(STAFF)
  /// Explicit permission list. Empty = use the role defaults.
  permissions      String[]  @default([])
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  devices        Device[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@index([businessId])
}

model Device {
  /// Generated by the desktop app on first launch (UUID) and sent on login.
  id         String    @id
  businessId String    @db.Uuid
  userId     String    @db.Uuid
  name       String
  platform   String?
  appVersion String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens   RefreshToken[]

  @@index([businessId])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  deviceId   String
  /// Rotation family: reuse of a revoked token revokes the entire family.
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── Billing ─────────────

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  /// Premium belongs to a DEVICE (the desktop never needs an account to subscribe).
  deviceId      String
  /// Optional links, filled when the payer is also signed in to a cloud account.
  businessId    String?            @db.Uuid
  userId        String?            @db.Uuid
  plan          SubscriptionPlan   @default(PREMIUM)
  price         Int
  currency      String             @default("XAF")
  status        SubscriptionStatus @default(ACTIVE)
  provider      String             @default("NOTCHPAY")
  transactionId String             @unique
  startedAt     DateTime
  expiresAt     DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([deviceId, status, expiresAt])
}

/// A device that has started a payment. The long random token (stored hashed) lets the app check/renew
/// its subscription and use the AI scan without any account sign-in.
model PremiumDevice {
  deviceId   String   @id
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
}

/// A Premium owner may share with up to nine shop PCs. A member can belong to only one shop at a time.
model PremiumShare {
  ownerDeviceId  String
  memberDeviceId String @id
  createdAt      DateTime @default(now())

  @@index([ownerDeviceId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  deviceId         String
  /// Our own unguessable reference (merchant reference) sent to Notch Pay; also the polling secret.
  reference        String        @unique
  /// Notch Pay transaction reference (trx.xxx) once known.
  notchReference   String?       @unique
  provider         String
  amount           Int
  currency         String        @default("XAF")
  phone            String?
  status           PaymentStatus @default(PENDING)
  rawProviderState Json?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([deviceId, createdAt])
}

// ───────────── Sync ─────────────

/// Current state of every synchronised business entity.
model SyncRecord {
  businessId String   @db.Uuid
  entityType String
  entityId   String
  version    Int
  data       Json
  deviceId   String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, entityType, entityId])
  @@index([businessId, entityType])
}

/// Append-only change log. `serverSeq` is the pull cursor and the version
/// history (kept for audit and support).
model SyncChange {
  serverSeq  BigInt   @id @default(autoincrement())
  businessId String   @db.Uuid
  entityType String
  entityId   String
  version    Int
  operation  String
  deleted    Boolean  @default(false)
  data       Json
  deviceId   String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, entityType, entityId, version])
  @@index([businessId, serverSeq])
}

/// Idempotency ledger: a re-sent operation returns the stored result.
model SyncOperation {
  businessId String   @db.Uuid
  opId       String
  deviceId   String
  result     Json
  createdAt  DateTime @default(now())

  @@id([businessId, opId])
}

/// Free, read-only "restore from cloud" for a device that is not (or no longer) Premium: lets an owner whose computer died get
/// their own data back without paying again. Time-boxed per device and capped per business so it cannot be used as a free mirror.
model RestoreGrant {
  deviceId   String   @id
  businessId String   @db.Uuid
  firstAt    DateTime @default(now())
  lastAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, firstAt])
}

/// One combined introductory trial per shop and device: one 30-minute cloud sync window and one successful AI shelf scan.
/// The business and device uniqueness constraints prevent another PC or a new account on the same registered PC from resetting it.
model BusinessTrial {
  businessId   String          @id @db.Uuid
  deviceId     String          @unique
  syncStartedAt DateTime?
  syncExpiresAt DateTime?
  scanStatus   TrialScanStatus @default(AVAILABLE)
  scanClaimId  String?
  scanClaimedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([syncExpiresAt])
}

// ───────────── Audit ─────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String?  @db.Uuid
  userId     String?  @db.Uuid
  deviceId   String?
  action     String
  entity     String?
  entityId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId])
}
