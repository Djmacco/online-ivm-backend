# ───────── Server ─────────
NODE_ENV=development
PORT=3000
# Allowed browser origins. The Tauri webview uses these (Windows prod: http://tauri.localhost, mac/linux: tauri://localhost).
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420,http://127.0.0.1:1420
# Public https base URL of this API (payment callback)
PUBLIC_API_URL=https://api.example.com

# ───────── Database (Supabase PostgreSQL) ─────────
# Pooled connection (Supabase "Transaction pooler", port 6543) used at runtime
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) used ONLY by `prisma migrate`
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ───────── JWT ─────────
JWT_SECRET=replace-with-64-random-bytes-hex
JWT_REFRESH_SECRET=replace-with-another-64-random-bytes-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ───────── Signed entitlements (Ed25519, raw hex) – run `npm run keys:generate` ─────────
# SECRET. The matching PUBLIC key goes in the desktop as VITE_ENTITLEMENT_PUBLIC_KEY.
ENTITLEMENT_PRIVATE_KEY=replace-me

# ───────── Notch Pay ─────────
NOTCHPAY_API_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=pk.replace-me      # initialises payments
NOTCHPAY_SECRET_KEY=sk.replace-me      # re-verifies every transaction
NOTCHPAY_HASH_KEY=replace-me           # webhook signature key (dashboard > Webhooks)
# E-mail Notch Pay requires on the customer record (devices have no account)
PAYMENT_CUSTOMER_EMAIL=payments@yourdomain.com

# ───────── Subscription (must equal PREMIUM_PRICE_XAF in desktop/src/entitlement/entitlement.ts) ─────────
PREMIUM_PRICE_XAF=3900
PREMIUM_PERIOD_DAYS=30

# ───────── Free "restore from cloud" for a replacement computer ─────────
# A device without Premium may restore its business data for this many days after its first restore call...
RESTORE_WINDOW_DAYS=7
# ...and at most this many such devices per business per 30 days (a recovery tool, not a free mirror).
RESTORE_MAX_DEVICES=3

# ───────── AI (server-side only: the key never reaches the app) ─────────
# Provider: gemini (default) | anthropic
AI_PROVIDER=gemini
# Google AI Studio key -> https://aistudio.google.com/apikey  (use a key with billing enabled for customer photos, see README)
AI_API_KEY=replace-me
# Gemini model code. Stable: gemini-3.6-flash (default) | gemini-3.8-flash (newer) | gemini-3.5-flash-lite (cheaper, faster)
# If AI_PROVIDER=anthropic use e.g. claude-sonnet-4-6.
AI_MODEL=gemini-3.6-flash
# Optional: base URL override for a gateway/proxy. Gemini default: https://generativelanguage.googleapis.com/v1beta
#           (for anthropic this is the full messages URL, default https://api.anthropic.com/v1/messages)
# AI_API_URL=
# Optional (Gemini): 0 switches "thinking" off on models that allow it -> faster and cheaper. Leave unset if a model rejects it.
# AI_THINKING_BUDGET=0
